            "tag": "master-964-1d0a58a"
          }
        },
        {
          "id": "trellis.cpp v0.8.1 HIP build",
          "kind": "archive",
          "format": "tar.gz",
          "url": "https://github.com/pwilkin/trellis.cpp/releases/download/v0.8.1/trellis-rocm-linux-x64.tar.gz",
          "size": 194792838,
          "sha256": "128ec2abd7364186ca9b079855f3f4564d7589cef88ee0f62c380c644b4be884",
          "dest": "trellis",
          "check": "trellis-cli",
          "upstream": {
