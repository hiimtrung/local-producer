{
  "_comment": "Engine packages: everything that is specific to one platform (GPU runtime libraries and the CLI builds the pipelines run), installed as a unit under ENGINES_DIR/<id>/<version>/ and loaded by app/engines/. The server image itself holds no GPU code, so a package can be installed, switched or reloaded while the server runs. Every download is pinned by URL, size and SHA256 like catalog/models.json. A package's runners name the CLIs the pipelines ask for (sd-cli: stable-diffusion.cpp, trellis-cli: trellis.cpp) with their library directories. Bumping a version means a new package version (all items reviewed together) and a CHANGELOG.md entry.",
  "version": 1,
  "_hosts": "A download (and every redirect it follows) must be https and its host must equal one of these domains or end with '.' + one of them (CDN hosts vary, e.g. us.aws.cdn.hf.co, release-assets.githubusercontent.com).",
  "allowed_domains": [
    "github.com",
    "githubusercontent.com",
    "repo.amd.com"
  ],
  "packages": [
    {
      "id": "rocm-gfx1103",
      "version": "2026.10.15",
      "title": "AMD ROCm 10.1 for Radeon 780M / 760M (gfx1103)",
      "description": "HIP builds of stable-diffusion.cpp master-964 (FLUX.2) and trellis.cpp v0.8.1 (TRELLIS.2) with AMD's TheRock ROCm 10.1.0 runtime for gfx1103. Needs the amdgpu kernel parameter cwsr_enable=0 (README.md).",
      "platform": {
        "os": "linux",
        "arch": "x86_64",
        "accelerator": "rocm",
        "gpu_targets": [
          "gfx1103"
        ]
      },
      "env": {
        "AMD_SERIALIZE_KERNEL": "3"
      },
      "lib_dirs": [
        "rocm/_rocm_sdk_core/lib",
        "rocm/_rocm_sdk_libraries/lib",
        "rocm/_rocm_sdk_core/lib/llvm/lib"
      ],
      "runners": {
        "sd-cli": {
          "bin": "sdcpp/sd-cli",
          "lib_dirs": [
            "sdcpp"
          ],
          "self_test": [
            "--version"
          ]
        },
        "trellis-cli": {
          "bin": "trellis/trellis-cli",
          "lib_dirs": [
            "trellis"
          ],
          "self_test": [
            "--help"
          ]
        }
      },
      "items": [
        {
          "id": "stable-diffusion.cpp master-964 HIP build",
